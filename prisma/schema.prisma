// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  avatarUrl     String?
  bio           String?
  coverGradient String?

  // Detail profil (Personal Information)
  headline    String?   // jabatan / headline singkat
  company     String?   // perusahaan / kampus
  location    String?   // kota / negara
  website     String?   // website atau portofolio
  githubUrl   String?
  linkedinUrl String?
  birthDate   DateTime? // tanggal lahir, umur dihitung dari sini
  gender      Gender?
  skills      String[]  @default([])
  languages   String[]  @default([])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   ProjectMember[]
  assignedTasks Task[]    @relation("TaskAssignee")
  createdTasks  Task[]    @relation("TaskCreator")
  comments      Comment[]

  messages               ProjectMessage[]
  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  activityLogs           ActivityLog[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  joinCode    String    @unique
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  members     ProjectMember[]
  lists       TaskList[]
  labels      Label[]

  messages       ProjectMessage[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
}

model ProjectMember {
  id       String    @id @default(cuid())
  role     Role      @default(MEMBER)
  joinedAt DateTime  @default(now())
  lastReadAt DateTime? // penanda belum dibaca di Diskusi (null = "sudah baca sampai joinedAt")

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
}

enum Role {
  ADMIN
  DEPUTY_ADMIN // Wakil Admin
  MEMBER
}

model TaskList {
  id        String    @id @default(cuid())
  name      String
  order     Int
  deletedAt DateTime?

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime? // diisi saat status menjadi DONE, dikosongkan bila status kembali
  order       Int
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  listId      String
  list        TaskList   @relation(fields: [listId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdById String? // pembuat/penugas task
  createdBy   User?   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  labels      Label[]    @relation("TaskLabels")
  comments    Comment[]

  notifications Notification[]
  activityLogs  ActivityLog[]

  @@index([completedAt])
  @@index([dueDate])
  @@index([listId])
  @@index([assigneeId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Label {
  id        String    @id @default(cuid())
  name      String
  color     String
  deletedAt DateTime?

  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]    @relation("TaskLabels")
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  notifications Notification[]
}

// ===================== Diskusi (chat grup per project) =====================

enum MessageKind {
  USER
  SYSTEM // pesan sistem, mis. "Firdaus bergabung ke project"
}

model ProjectMessage {
  id        String      @id @default(cuid())
  kind      MessageKind @default(USER)
  content   String
  pinnedAt  DateTime? // pesan tersemat
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  replyToId String?
  replyTo   ProjectMessage?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ProjectMessage[] @relation("MessageReply")

  notifications Notification[]

  @@index([projectId, createdAt])
}

enum NotificationType {
  TASK_ASSIGNED
  MENTION
  DUE_SOON
  MEMBER_JOINED
  PROJECT_COMPLETED
  TASK_COMMENT
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId    String // penerima
  user      User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId   String? // pelaku (mis. yang menugaskan)
  actor     User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  messageId String? // mention di Diskusi
  message   ProjectMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
}

// ===================== Aktivitas =====================

enum ActivityAction {
  PROJECT_CREATED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  COMMENT_ADDED
  FILE_UPLOADED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
}

model ActivityLog {
  id        String         @id @default(cuid())
  action    ActivityAction
  meta      Json? // data tambahan, mis. { title, from, to }
  createdAt DateTime       @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}
